# =====================================================================
# Technical Discussion Forum - Environment Configuration
# =====================================================================
# Instructions:
# 1. Copy this file and rename it to ".env" in the same folder (config/.env)
# 2. Select your environment: APP_ENV=local OR APP_ENV=tidb
# 3. Fill in the corresponding database credentials below
# =====================================================================

# Environment selection: 'local' (XAMPP MySQL) or 'tidb' (TiDB Cloud)
APP_ENV=local

# Application settings
APP_NAME="ThredIt"
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------
# LOCAL DATABASE CONFIGURATION (XAMPP / MariaDB / MySQL)
# ---------------------------------------------------------------------
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_DATABASE=forum_db
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=

# ---------------------------------------------------------------------
# TiDB CLUSTER DATABASE CONFIGURATION (TiDB Cloud Serverless)
# ---------------------------------------------------------------------
# Retrieve these from your TiDB Cloud Console -> Connect -> General
TIDB_DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_DB_PORT=4000
TIDB_DB_DATABASE=forum_db
TIDB_DB_USERNAME=your_tidb_username_here
TIDB_DB_PASSWORD=your_tidb_password_here

# TLS/SSL Certificate Authority path for TiDB Cloud
# Default on XAMPP Windows: C:/xampp/apache/bin/curl-ca-bundle.crt
# Default on Linux: /etc/ssl/certs/ca-certificates.crt
TIDB_DB_SSL_CA=C:/xampp/apache/bin/curl-ca-bundle.crt
